{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**/*)",
      "Read(./**/vendor/**/*)",
      "Read(./**/dist/**/*)",
      "Read(./**/build/**/*)",
      "Read(./**/out/**/*)",
      "Read(./**/.next/**/*)",
      "Read(./**/coverage/**/*)",
      "Read(./**/__pycache__/**/*)",
      "Read(./**/*.min.js)",
      "Read(./**/*.map)",
      "Read(./**/*.generated.*)",
      "Read(./**/*.pb.go)",
      "Read(./**/package-lock.json)",
      "Read(./**/yarn.lock)",
      "Read(./**/pnpm-lock.yaml)",
      "Read(./**/poetry.lock)",
      "Read(./**/Cargo.lock)",
      "Read(./**/*.log)",
      "Read(./**/*.sqlite)",
      "Read(./**/*.db)",
      "Read(./**/*.csv)",
      "Read(./**/*.parquet)",
      "Read(./**/*.zip)",
      "Read(./**/*.tar.gz)",
      "Read(./**/*.png)",
      "Read(./**/*.jpg)",
      "Read(./**/*.mp4)",
      "Read(./**/*.pdf)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": true,
    "playwright@anthropic-plugin-directory": true
  }
}
